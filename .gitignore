# .gitignore

# Build output
/target/
/java/build/
/java/.gradle/
# Classes the editor's Java support compiles for itself when it opens java/
/java/bin/

# Editor and OS files
.idea/
# The editor settings are tracked — they carry the null-analysis configuration
# of the Java library — and nothing else of the editor's is.
.vscode/*
!.vscode/settings.json
.DS_Store
